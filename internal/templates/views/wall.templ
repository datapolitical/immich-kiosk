package views

templ Wall() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<style>
				html, body {
					height: 100%;
					margin: 0;
					padding: 0;
				}

				.container {
					display: flex;
					flex-wrap: wrap;
					justify-content: center;
					gap: 0;
				}

				img {
					width: 100%;
					max-width: 50vw;
					height: auto;
				}
			</style>
		</head>
		<body>
			<div class="container">
				for i := 0; i < 24; i++ {
					<img
						class="reveal-trigger"
						loading="lazy"
						decoding="async"
						src="/image"
					/>
				}
			</div>
		</body>
	</html>
}
