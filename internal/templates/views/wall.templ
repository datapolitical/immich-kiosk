package views

templ Wall() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<style>
				html, body {
					height: 100%;
					margin: 0;
					padding: 0;
					background: #000;
				}

				.container {
					display: grid;
					grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
					gap: 8px;
					padding: 8px;
					align-items: start;
				}

				img {
					width: 100%;
					height: auto;
					object-fit: contain;
					display: block;
					background: #111;
					cursor: pointer;
				}

				img.is-liked {
					outline: 4px solid #ff375f;
					outline-offset: -4px;
				}

				#wall-sentinel {
					height: 1px;
				}
			</style>
		</head>
		<body>
			<div id="wall-container" class="container"></div>
			<div id="wall-sentinel" aria-hidden="true"></div>

			<script>
				const container = document.getElementById('wall-container');
				const sentinel = document.getElementById('wall-sentinel');
				let imageCount = 0;
				let isAppending = false;
				const BATCH_SIZE = 24;
				const PRELOAD_DISTANCE_PX = 1500;

				function appendImage() {
					return new Promise((resolve) => {
						const img = document.createElement('img');
						img.loading = 'lazy';
						img.decoding = 'async';
						img.alt = 'Random photo';
						img.addEventListener('click', () => toggleLike(img));

						img.onload = () => {
							const objectURL = img.dataset.objectUrl;
							if (objectURL) {
								URL.revokeObjectURL(objectURL);
								delete img.dataset.objectUrl;
							}
							resolve();
						};
						img.onerror = () => {
							const objectURL = img.dataset.objectUrl;
							if (objectURL) {
								URL.revokeObjectURL(objectURL);
								delete img.dataset.objectUrl;
							}
							resolve();
						};

						fetch(`/image?wall=${Date.now()}-${imageCount}`)
							.then(async (response) => {
								if (!response.ok) {
									throw new Error('Failed to fetch image');
								}

								const assetID = response.headers.get('X-Asset-ID');
								const isLiked = response.headers.get('X-Asset-Liked') === 'true';
								const blob = await response.blob();

								if (assetID) {
									img.dataset.assetId = assetID;
								}

								img.dataset.liked = `${isLiked}`;
								img.classList.toggle('is-liked', isLiked);
								const objectURL = URL.createObjectURL(blob);
								img.dataset.objectUrl = objectURL;
								img.src = objectURL;
							})
							.catch(() => {
								img.remove();
								resolve();
							});

						container.appendChild(img);
						imageCount += 1;
					});
				}

				function toggleLike(img) {
					const assetID = img.dataset.assetId;
					if (!assetID || img.dataset.loading === 'true') {
						return;
					}

					const isLiked = img.dataset.liked === 'true';
					const endpoint = isLiked ? '/asset/unlike' : '/asset/like';
					const formData = new URLSearchParams();
					formData.set('assetID', assetID);

					img.dataset.loading = 'true';

					fetch(endpoint, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
						},
						body: formData.toString()
					})
						.then((response) => {
							if (!response.ok) {
								throw new Error('Unable to update like state');
							}

							const updatedLikedState = !isLiked;
							img.dataset.liked = `${updatedLikedState}`;
							img.classList.toggle('is-liked', updatedLikedState);
						})
						.catch(() => {})
						.finally(() => {
							img.dataset.loading = 'false';
						});
				}

				function sentinelWithinPreloadRange() {
					return sentinel.getBoundingClientRect().top - window.innerHeight < PRELOAD_DISTANCE_PX;
				}

				async function appendImages(count) {
					if (isAppending) {
						return;
					}

					isAppending = true;

					while (sentinelWithinPreloadRange()) {
						for (let i = 0; i < count; i++) {
							await appendImage();
						}
					}

					isAppending = false;
				}

				appendImages(BATCH_SIZE);

				const observer = new IntersectionObserver((entries) => {
					if (entries.some((entry) => entry.isIntersecting)) {
						appendImages(BATCH_SIZE);
					}
				}, {
					root: null,
					rootMargin: `${PRELOAD_DISTANCE_PX}px 0px`
				});

				observer.observe(sentinel);
			</script>
		</body>
	</html>
}
